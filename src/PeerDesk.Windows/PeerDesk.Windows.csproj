<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Version.props" />
  <Target Name="RefreshProductVersion" BeforeTargets="GetAssemblyVersion">
    <Exec Command="powershell.exe -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/Update-Version.ps1&quot; -ProjectRoot &quot;$(MSBuildProjectDirectory)/../..&quot;" Timeout="15000" />
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)/Version.props" Query="/Project/PropertyGroup/Version/text()"><Output TaskParameter="Result" PropertyName="Version" /></XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)/Version.props" Query="/Project/PropertyGroup/AssemblyVersion/text()"><Output TaskParameter="Result" PropertyName="AssemblyVersion" /></XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)/Version.props" Query="/Project/PropertyGroup/FileVersion/text()"><Output TaskParameter="Result" PropertyName="FileVersion" /></XmlPeek>
    <PropertyGroup>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>PeerDesk.Windows</RootNamespace>
    <AssemblyName>RemoteBridge</AssemblyName>
    <Product>RemoteBridge (리모트브리지)</Product>
    <AssemblyTitle>RemoteBridge (리모트브리지)</AssemblyTitle>
    <Description>RemoteBridge (리모트브리지) Windows 원격 연결 클라이언트</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="directory-bootstrap.embedded.json" LogicalName="PeerDesk.Windows.DirectoryBootstrap.json" />
  </ItemGroup>
  <ItemGroup><Compile Include="../PeerDesk.ReleaseSecurity/*.cs" Link="ReleaseSecurity/%(Filename)%(Extension)" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Locales/*.json" LogicalName="PeerDesk.Windows.Locales.%(Filename)%(Extension)" /></ItemGroup>
</Project>
